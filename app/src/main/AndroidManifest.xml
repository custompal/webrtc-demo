<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml —— 应用清单
  依据：doc/10 §6（权限）、doc/13 阶段 4、D3（包名 com.example.webrtcdemo）、
        D6（日志导出 → 必须声明 FileProvider）。
  minSdk 26 / targetSdk 34 / compileSdk 34（doc/10 §1）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================= 权限 ========================= -->
    <!-- 信令 WebSocket（wss://）与 RTP/SRTP 媒体传输 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 摄像头采集（D1：org.webrtc.Camera2Capturer） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 麦克风采集（D1：org.webrtc.JavaAudioDeviceModule） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 以下两项为普通权限（无运行时弹窗），WebRTC 媒体层/连通性判断需要 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ========================= 硬件特性 ========================= -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- libwebrtc 渲染（SurfaceViewRenderer/EGL）需要 GLES 2.0 -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name=".WebRtcDemoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebRtcDemo"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic=true：学习 demo 允许直连 ws://<IP>:8443 明文信令
          （doc/09 §1 的正式形态是 Caddy 反代的 wss://）。若只走 wss:// 可删除此项收紧密集度。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WebRtcDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ==================== FileProvider（D6 日志导出，doc/14 §9.5） ====================
          authority 冻结为字面量 com.example.webrtcdemo.fileprovider
          （= ${applicationId}.fileprovider；与 LogExporter.AUTHORITY 一致）。
          可导出路径见 res/xml/file_paths.xml：<files-path logs/> + <cache-path ./>
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.webrtcdemo.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
